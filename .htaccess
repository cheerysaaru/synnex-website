AddType text/javascript .mjs
RewriteEngine On
RewriteBase /

# One official address: https://synnex-technology.com (no www, always https)
RewriteCond %{HTTP_HOST} ^www\.synnex-technology\.com$ [NC]
RewriteRule ^(.*)$ https://synnex-technology.com/$1 [R=301,L]
RewriteCond %{HTTP:X-Forwarded-Proto} ^http$
RewriteRule ^(.*)$ https://synnex-technology.com/$1 [R=301,L]

# Admin quotation tool: its own app in /quotation-app, shown at /admin/quotation/
RewriteRule ^admin/quotation$ /admin/quotation/ [R=301,L]
RewriteRule ^admin/quotation/$ /quotation-app/index.html [L]
RewriteRule ^admin/quotation/(.+)$ /quotation-app/$1 [L]

# Public pages: ready-made HTML (generated by scripts/postbuild_seo.py)
RewriteRule ^$ /_p/home.html [L]
RewriteRule ^about/?$ /_p/about.html [L]
RewriteRule ^team/?$ /_p/team.html [L]
RewriteRule ^safety/?$ /_p/safety.html [L]
RewriteRule ^certifications/?$ /_p/certifications.html [L]
RewriteRule ^careers/?$ /_p/careers.html [L]
RewriteRule ^solutions/?$ /_p/solutions.html [L]
RewriteRule ^solutions/lightning\-protection/?$ /_p/solutions__lightning-protection.html [L]
RewriteRule ^solutions/residential/?$ /_p/solutions__residential.html [L]
RewriteRule ^solutions/commercial/?$ /_p/solutions__commercial.html [L]
RewriteRule ^solutions/industrial/?$ /_p/solutions__industrial.html [L]
RewriteRule ^solutions/solar/?$ /_p/solutions__solar.html [L]
RewriteRule ^solutions/testing/?$ /_p/solutions__testing.html [L]
RewriteRule ^solutions/power\-backup/?$ /_p/solutions__power-backup.html [L]
RewriteRule ^case\-studies/?$ /_p/case-studies.html [L]
RewriteRule ^case\-studies/modern\-residence\-wiring/?$ /_p/case-studies__modern-residence-wiring.html [L]
RewriteRule ^case\-studies/retail\-distribution\-upgrade/?$ /_p/case-studies__retail-distribution-upgrade.html [L]
RewriteRule ^case\-studies/workshop\-power\-planning/?$ /_p/case-studies__workshop-power-planning.html [L]
RewriteRule ^case\-studies/rooftop\-solar\-pv/?$ /_p/case-studies__rooftop-solar-pv.html [L]
RewriteRule ^news/?$ /_p/news.html [L]
RewriteRule ^news/new\-solar\-installations/?$ /_p/news__new-solar-installations.html [L]
RewriteRule ^news/safety\-inspection\-season/?$ /_p/news__safety-inspection-season.html [L]
RewriteRule ^news/colombo\-office\-move/?$ /_p/news__colombo-office-move.html [L]
RewriteRule ^blog/?$ /_p/blog.html [L]
RewriteRule ^blog/signs\-your\-board\-needs\-attention/?$ /_p/blog__signs-your-board-needs-attention.html [L]
RewriteRule ^blog/solar\-payback\-explained/?$ /_p/blog__solar-payback-explained.html [L]
RewriteRule ^blog/choosing\-cable\-size/?$ /_p/blog__choosing-cable-size.html [L]
RewriteRule ^blog/generator\-or\-ups/?$ /_p/blog__generator-or-ups.html [L]
RewriteRule ^docs/?$ /_p/docs.html [L]
RewriteRule ^faq/?$ /_p/faq.html [L]
RewriteRule ^resources/safety\-checklist/?$ /_p/resources__safety-checklist.html [L]
RewriteRule ^resources/solar\-guide/?$ /_p/resources__solar-guide.html [L]
RewriteRule ^areas/?$ /_p/areas.html [L]
RewriteRule ^areas/jaffna/?$ /_p/areas__jaffna.html [L]
RewriteRule ^areas/kilinochchi/?$ /_p/areas__kilinochchi.html [L]
RewriteRule ^areas/mullaitivu/?$ /_p/areas__mullaitivu.html [L]
RewriteRule ^areas/vavuniya/?$ /_p/areas__vavuniya.html [L]
RewriteRule ^areas/mannar/?$ /_p/areas__mannar.html [L]
RewriteRule ^areas/batticaloa/?$ /_p/areas__batticaloa.html [L]
RewriteRule ^areas/ampara/?$ /_p/areas__ampara.html [L]
RewriteRule ^areas/trincomalee/?$ /_p/areas__trincomalee.html [L]
RewriteRule ^areas/colombo/?$ /_p/areas__colombo.html [L]
RewriteRule ^areas/anuradhapura/?$ /_p/areas__anuradhapura.html [L]
RewriteRule ^contact/?$ /_p/contact.html [L]
RewriteRule ^cookies/?$ /_p/cookies.html [L]

# Everything else: the app. Missing files (anything with an extension, e.g.
# /.well-known/ard.json or /old.png) get a real 404 instead of the app page.
RewriteRule ^index\.html$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !\.[A-Za-z0-9]{1,8}$
RewriteRule . /index.html [L]
